{%  style  %} 

/* colors */

:root{
    --nw-white-color: #FFFFFF;
    --nw-black-color: #000000;
    --nw-bg-color: #F0EFED;


      /* ===========================
     Reusable Color Variables
  =========================== */

    --nw-white: var(--nw-white-color);
    --nw-black: var(--nw-black-color);
    --nw-bg: var(--nw-bg-color);


    /* ===========================
     font-families
  =========================== */
--nw-font-heading: 'Integral CF', sans-serif;
--nw-font-body: 'Satoshi', sans-serif;
--nw-font-body-600-800: 'Satoshi Variable', sans-serif;
}


