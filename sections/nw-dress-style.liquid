{% assign shell_selector = '.nw-dress-style.section-' | append: section.id %}
{% render 'nw-section-shell', selector: shell_selector %}

{{ 'nw-dress-style.css' | asset_url | stylesheet_tag }}


<div class="nw-dress-style section-{{ section.id }}">
  <div class="page-width">
    <div
      class="nw-dress-style_container"
      style="background-color: {{ section.settings.container_bg | default: '#F0F0F0' }};"
    >
      {% render 'nw-section-header',
        heading: section.settings.heading,
        align: section.settings.header_alignment,
        heading_color: section.settings.heading_color
      %}

      {%- if section.blocks.size > 0 -%}
        <div class="nw-dress-style__grid">
          {%- assign prev_span = '' -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign col = block.settings.collection
              if block.settings.is_collection_data
                assign box_title = col.title | default: block.settings.title
                assign box_image = col.featured_image | default: block.settings.collection_image
              else
                assign box_title = block.settings.title | default: col.title
                assign box_image = block.settings.collection_image | default: col.featured_image
              endif

              assign span_class = block.settings.col_span | default: 'col-span-1'
              assign row_pos = forloop.index0 | modulo: 2
              if row_pos == 0
                assign prev_span = span_class
              elsif prev_span == 'col-span-2' and span_class == 'col-span-2'
                assign span_class = 'col-span-1'
              endif

              assign placeholder_idx = forloop.index | modulo: 4 | plus: 1
            -%}

            <a
              href="{{ col.url | default: '#' }}"
              class="nw-dress-style__card nw-dress-style__card--{{ span_class }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {{ block.shopify_attributes }}
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
            >
              {%- if box_title != blank -%}
                <h3 class="nw-dress-style__card-title">{{ box_title | escape }}</h3>
              {%- endif -%}

              <div class="nw-dress-style__card-media">
                {%- if box_image != blank -%}
                  <img
                    src="{{ box_image | image_url: width: 1000 }}"
                    alt="{{ box_image.alt | default: box_title | escape }}"
                    class="nw-dress-style__card-img"
                    width="{{ box_image.width }}"
                    height="{{ box_image.height }}"
                    loading="lazy"
                  >
                {%- else -%}
                  {{ 'collection-' | append: placeholder_idx | placeholder_svg_tag: 'nw-dress-style__card-placeholder' }}
                {%- endif -%}
              </div>
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show-hide-btn and section.settings.button_text != blank -%}
        <div class="nw-dress-style__cta">
          {% render 'nw-button',
            text: section.settings.button_text,
            link: section.settings.button_link,
            type: section.settings.button_type,
            align: section.settings.button_alignment
          %}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>








